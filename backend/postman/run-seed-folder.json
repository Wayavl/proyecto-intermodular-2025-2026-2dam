			"name": "01 — Register admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Admin register (201 or 409)', () => {",
							"  pm.expect([201, 409]).to.include(pm.response.code);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@paralearn.com\",\n  \"password\": \"admin\"\n}"
				},
				"url": "{{base_url}}/api/users/register"
